rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }
    match /admins/{uid} { allow read: if request.auth.uid == uid; allow write: if false; }
    match /auditLogs/{id} { allow read: if admin(); allow create: if admin(); allow update, delete: if false; }
    match /{collection}/{document=**} { allow read, write: if admin(); }
  }
}
